[
  {
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Default capabilities for the main window",
    "windows": ["main"],
    "permissions": [
      "core:default",
      "core:webview:allow-create-webview-window",
      "core:window:allow-set-focus",
      {
        "identifier": "http:default",
        "allow": [
          "https://fanyi-api.baidu.com/*",
          "https://translate.googleapis.com/*",
          "https://translate.google.com/*",
          "https://www.bing.com/*"
        ]
      },
      "fs:allow-appconfig-read-recursive",
      "fs:allow-appconfig-write-recursive",
      "fs:allow-download-write-recursive",
      "opener:default"
    ]
  },
  {
    "identifier": "image-preview",
    "description": "Capabilities for the image preview window: close itself and listen for image updates from the main window",
    "windows": ["image-preview"],
    "permissions": ["core:window:allow-close", "core:event:default"]
  }
]
